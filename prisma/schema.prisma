datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    JOB_SEEKER
    COMPANY
}

enum ApplicationStatus {
    APPLIED
    REVIEWING
    SHORTLISTED
    REJECTED
    ACCEPTED
}

enum JobType {
    FULL_TIME
    PART_TIME
    CONTRACT
    INTERNSHIP
    REMOTE
}

enum JobStatus {
    DRAFT
    OPEN
    CLOSED
}

model User {
    id           String   @id @default(uuid())
    email        String   @unique
    passwordHash String
    name         String
    role         Role
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    jobs         Job[]                @relation("CompanyJobs")
    applications Application[]        @relation("ApplicantJobs")
    auditLogs    ApplicationHistory[] @relation("AuditModifier")
}

model Job {
    id          String    @id @default(uuid())
    companyId   String
    company     User      @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Cascade)
    title       String
    description String
    location    String
    salary      String
    jobType     JobType
    status      JobStatus @default(OPEN)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    applications Application[]

    @@index([companyId])
    @@index([createdAt])
    @@index([status])
}

model Application {
    id          String            @id @default(uuid())
    jobId       String
    job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
    applicantId String
    applicant   User              @relation("ApplicantJobs", fields: [applicantId], references: [id], onDelete: Cascade)
    status      ApplicationStatus @default(APPLIED)
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    histories ApplicationHistory[]

    @@unique([jobId, applicantId])
    @@index([jobId])
    @@index([applicantId])
    @@index([status])
}

model ApplicationHistory {
    id            String             @id @default(uuid())
    applicationId String
    application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
    fromStatus    ApplicationStatus?
    toStatus      ApplicationStatus
    changedById   String
    changedBy     User               @relation("AuditModifier", fields: [changedById], references: [id])
    createdAt     DateTime           @default(now())

    @@index([applicationId])
    @@index([changedById])
    @@index([createdAt])
}
